{
  "game": {
    "transitions": {
      "preGame": {
        "startGame": "inGame"
      },
      "inGame": {
        "halfTime": "halfTime",
        "endQuarter": "preQuarter",
        "endGame": "postGame"
      },
      "preQuarter": {
        "startQuarter": "inGame"
      },
      "halfTime": {
        "resume": "preQuarter",
        "endGame": "postGame"
      },
      "postGame": {
        "reset": "preGame",
        "startOT": "inGame"
      }
    }
  },

  "operation": {
    "modes": {
      "foulMode": true,
      "substitutionMode": true
    },
    "transitions": {
      "foulMode": {
        "confirm": "confirmFoul"
      },
      "substitutionMode": {
        "confirm": "confirmSubstitution"
      }
    }
  },

  "confirm": {
    "transitions": {
      "confirmFoul": {
        "ok": "inGame",
        "fix": "foulMode"
      },
      "confirmSubstitution": {
        "ok": "inGame",
        "fix": "substitutionMode"
      }
    }
  },

  "teams": {
    "rules": {
      "maxTeamFoulsPerQuarter": 5
    },
    "teams": {
      "teamA": { "teamFouls": 0 },
      "teamB": { "teamFouls": 0 }
    }
  },

  "players": {
    "rules": {
      "maxPersonalFouls": 5
    },
    "players": []
  },

  "ui": {
    "colors": {
      "normal": "#4D9FFF",
      "warning": "#FFAA00",
      "danger": "#FF4444"
    }
  },

  "sound": {
    "addFoul": "sounds/add.mp3",
    "subFoul": "sounds/sub.mp3",
    "reset": "sounds/reset.mp3"
  }
}
